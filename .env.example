# Copy this file to .env locally. Never commit .env.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Optional Telegram notifications. Leave blank unless you configure a fresh,
# private bot token and the intended chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# No Binance account API credentials are needed by the current research tools.
